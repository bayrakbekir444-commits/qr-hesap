# --- Production environment variables ---
# Bu dosyayı .env olarak kopyala ve değerleri doldur (.env git'e gitmez).

# JWT için gizli anahtar — production'da MUTLAKA değiştir!
# Üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cok-uzun-rastgele-bir-string-buraya

# Backend portu (Railway/Render otomatik atar, dokunma)
PORT=3001

# CORS — frontend domain'ini buraya yaz, virgül ile ayır
# Örn: https://qrhesap.vercel.app,https://qrhesap.com
CORS_ORIGIN=http://localhost:5173

# Postgres bağlantısı — Render Postgres URL'ini buraya yapıştır
# Örn: postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://localhost:5432/qrhesap

# Lokal Postgres (SSL'siz) için bunu 1 yap. Render'da boş bırak (SSL açık olur).
# PG_NO_SSL=1

# Postgres pool boyutu (opsiyonel)
# PG_POOL_MAX=10

# Frontend base URL (QR kodlarında kullanılır)
CLIENT_BASE_URL=http://localhost:5173

# Admin paneli giriş bilgileri (zorla değiştir)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# iyzico — kartlı ödeme entegrasyonu
# Sandbox (test): https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=sandbox-xxxxx
IYZICO_SECRET_KEY=sandbox-xxxxx
# 3DS sonrası iyzico'nun bizim backend'e POST atacağı URL
IYZICO_CALLBACK_URL=https://api.qrhesap.net/api/payments/iyzico/callback

# Anthropic API — AI Garson (chatbot)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx
