# --- Production environment variables ---
# Bu dosyayı .env olarak kopyala ve değerleri doldur (.env git'e gitmez).

# JWT için gizli anahtar — production'da MUTLAKA değiştir!
# Üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cok-uzun-rastgele-bir-string-buraya

# Backend portu (Railway/Render otomatik atar, dokunma)
PORT=3001

# CORS — frontend domain'ini buraya yaz, virgül ile ayır
# Örn: https://qrhesap.vercel.app,https://qrhesap.com
CORS_ORIGIN=http://localhost:5173

# SQLite dosya yolu (Railway/Render volume için)
# Örn: /data/database.sqlite
DB_PATH=./db/database.sqlite
